{
  "name": "keyboard-stats",
  "version": "1.0.0",
  "description": "Generates system stats image for be quiet! Dark Mount media dock",
  "main": "generate.js",
  "scripts": {
    "start": "node generate.js",
    "upload": "node automate.js",
    "preview": "node preview.js",
    "preview:clock": "node preview.js clock --time 10:10 --out preview_clock.png",
    "preview:stats": "node preview.js stats --out preview_stats.png",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.32.6",
    "systeminformation": "^5.22.11"
  }
}
